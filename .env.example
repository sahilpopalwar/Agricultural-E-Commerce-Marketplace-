# Copy these values into your shell environment; do not commit real credentials.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Optional Clerk browser and API configuration.
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_ENABLED=false
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Kafka order-delivery streaming.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_DELIVERY_TOPIC=order-delivery-events
KAFKA_CONSUMER_GROUP=order-delivery-service
KAFKA_LISTENER_AUTO_STARTUP=true

# Kafka order delivery streaming (never commit credentials or private endpoints).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_DELIVERY_TOPIC=order-delivery-events
KAFKA_CONSUMER_GROUP=order-delivery-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_LISTENER_AUTO_STARTUP=true
